# PostgreSQL 接続先
DATABASE_URL="postgresql://bbs:bbs@localhost:5432/bbs?schema=public"

PORT=3000
NODE_ENV=development

# CORS で許可するオリジン（カンマ区切り。空なら CORS 無効）
CORS_ORIGINS=http://localhost:5173

# セッション有効日数
SESSION_TTL_DAYS=30

# seed 用（任意）。設定すると管理者ユーザーを作成します
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
